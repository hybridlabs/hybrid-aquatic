{
    "schemaVersion": 1,
    "id": "hybrid_aquatic",
    "version": "${version}",

    "name": "Hybrid Aquatic",
    "description": "${description}",

    "authors": [
        "Hybrid Labs"
    ],

    "contact": {
        "homepage": "https://hybridlabs.net/",
        "sources": "https://github.com/hybridlabs/hybrid-aquatic",
        "issues": "https://github.com/hybridlabs/hybrid-aquatic/issues"
    },

    "license": "ARR",
    "icon": "assets/hybrid_aquatic/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "dev.hybridlabs.aquatic.HybridAquatic",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "dev.hybridlabs.aquatic.HybridAquaticClient",
                "adapter": "kotlin"
            }

        ],
        "fabric-datagen": [
            {
                "value": "dev.hybridlabs.aquatic.data.HybridAquaticDataGenerator",
                "adapter": "kotlin"
            }
        ],
        "preLaunch": [
            "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
        ]
    },

    "mixins": [
        "hybrid_aquatic.fabric.mixins.json"
    ],

    "accessWidener": "hybrid_aquatic.accesswidener",

    "depends": {
        "minecraft": "~1.20.1",
        "java": ">=17",
        "fabric-language-kotlin": "*",
        "fabric-api": ">=0.92",
        "geckolib": ">=4.4",
        "lithostitched": ">=1.4.11",
        "biolith": "*",
        "trinkets": ">=3.7.1",
        "hapi": ">=1.0.0"
    },

    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/class_1657": [
                "dev/hybridlabs/aquatic/access/CustomPlayerEntityData"
            ]
        }
    }
}
