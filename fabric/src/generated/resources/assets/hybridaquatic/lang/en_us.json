  "hybridaquatic.sea_message.loss": "| ||\n|| |_",
  "hybridaquatic.sea_message.mylo": "Mylo, you are the best friend I could have ever hoped to have. \nRest in peace, my sweet prince. I hope you have sweet dreams and find the peace you deserve.",
